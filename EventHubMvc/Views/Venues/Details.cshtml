@model EventHubMvc.Models.Venue

@{
    ViewData["Title"] = "Venue Details";
}

<section class="mb-4">
    <h1 class="fw-bold mb-1">Venue Details</h1>
    <p class="text-muted mb-0">
        View detailed information about this event location.
    </p>
</section>

<div class="card shadow-sm border-0">
    <div class="card-body">

        <span class="badge bg-success mb-3">Venue</span>

        <h3 class="fw-bold mb-3">
            @Model.Name
        </h3>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="border rounded-3 p-3 h-100">
                    <small class="text-muted d-block">City</small>
                    <strong>@Model.City</strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="border rounded-3 p-3 h-100">
                    <small class="text-muted d-block">Capacity</small>
                    <strong>@Model.Capacity people</strong>
                </div>
            </div>

            <div class="col-12">
                <div class="border rounded-3 p-3">
                    <small class="text-muted d-block">Address</small>
                    <strong>@Model.Address</strong>
                </div>
            </div>
        </div>

        <p class="text-muted">
            This venue can be used to host different events inside the EventHub platform.
        </p>

        <hr />

        <div class="d-flex flex-wrap gap-2">

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit"
                       asp-route-id="@Model?.VenueId"
                       class="btn btn-outline-dark">
                    Edit
                </a>
            }

        </div>

    </div>
</div>