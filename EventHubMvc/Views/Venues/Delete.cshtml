@model EventHubMvc.Models.Venue

@{
    ViewData["Title"] = "Delete Venue";
}

<section class="mb-4">
    <h1 class="fw-bold mb-1 text-danger">Delete Venue</h1>
    <p class="text-muted mb-0">Confirm if you want to delete this venue.</p>
</section>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="alert alert-danger">
            Are you sure you want to delete this venue?
        </div>

        <span class="badge bg-success mb-3">Venue</span>
        <h3 class="fw-bold">@Model.Name</h3>

        <ul class="list-unstyled">
            <li><strong>City:</strong> @Model.City</li>
            <li><strong>Address:</strong> @Model.Address</li>
            <li><strong>Capacity:</strong> @Model.Capacity</li>
        </ul>

        <hr />

        <form asp-action="Delete">
            <input type="hidden" asp-for="VenueId" />

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>