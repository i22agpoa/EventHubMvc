@model EventHubMvc.Models.Category

@{
    ViewData["Title"] = "Category Details";
}

<section class="mb-4">
    <h1 class="fw-bold mb-1">Category Details</h1>
    <p class="text-muted mb-0">
        View information about this event category.
    </p>
</section>

<div class="card shadow-sm border-0">
    <div class="card-body">

        <span class="badge bg-dark mb-3">Category</span>

        <h3 class="fw-bold mb-3">
            @Model.Name
        </h3>

        <p class="text-muted">
            This category is used to organize events inside EventHub.
        </p>

        <hr />

        <div class="d-flex flex-wrap gap-2">

            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit"
                       asp-route-id="@Model?.CategoryId"
                       class="btn btn-outline-dark">
                    Edit
                </a>
            }

        </div>

    </div>
</div>