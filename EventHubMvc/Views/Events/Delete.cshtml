@model EventHubMvc.Models.Event

@{
    ViewData["Title"] = "Delete Event";
}

<section class="mb-4">
    <h1 class="fw-bold mb-1 text-danger">Delete Event</h1>
    <p class="text-muted mb-0">Confirm if you want to delete this event.</p>
</section>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="alert alert-danger">
            Are you sure you want to delete this event?
        </div>

        <h3 class="fw-bold">@Model.Title</h3>
        <p class="text-muted">@Model.Description</p>

        <ul class="list-unstyled">
            <li><strong>Date:</strong> @Model.Date.ToString("dd/MM/yyyy HH:mm")</li>
            <li><strong>Price:</strong> @Model.Price €</li>
            <li><strong>Category:</strong> @(Model.Category != null ? Model.Category.Name : "Not specified")</li>
            <li><strong>Venue:</strong> @(Model.Venue != null ? Model.Venue.Address : "Not specified")</li>
            <li><strong>Organizer:</strong> @(Model.Organizer != null ? Model.Organizer.Email : "Not specified")</li>
        </ul>

        <hr />

        <form asp-action="Delete">
            <input type="hidden" asp-for="EventId" />

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>