@model IEnumerable<EventHubMvc.Models.Event>

@{
    ViewData["Title"] = "Events";
}

<section class="mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h1 class="fw-bold mb-1">Events</h1>
            <p class="text-muted mb-0">
                Browse upcoming events and find activities that match your interests.
            </p>
        </div>

        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">
                Create New Event
            </a>
        }
    </div>
</section>

<form asp-action="Index" method="get" class="mb-4">
    <div class="input-group input-group-lg shadow-sm">
        <input type="text"
               name="searchTerm"
               value="@ViewData["CurrentFilter"]"
               class="form-control"
               placeholder="Search by title, description, category or city" />

        <button type="submit" class="btn btn-primary">
            Search
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Clear
        </a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No events found.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var item in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body d-flex flex-column">
                        <div class="mb-3">
                            <span class="badge bg-primary">
                                @(item.Category != null ? item.Category.Name : "Uncategorized")
                            </span>
                        </div>

                        <h5 class="card-title fw-bold">
                            @item.Title
                        </h5>

                        <p class="card-text text-muted">
                            @item.Description
                        </p>

                        <ul class="list-unstyled small mb-4">
                            <li>
                                <strong>Date:</strong> @item.Date.ToString("dd/MM/yyyy HH:mm")
                            </li>
                            <li>
                                <strong>Price:</strong> @item.Price €
                            </li>
                            <li>
                                <strong>Venue:</strong> @(item.Venue != null ? item.Venue.Address : "")
                            </li>
                            <li>
                                <strong>Organizer:</strong> @(item.Organizer != null ? item.Organizer.Email : "")
                            </li>
                        </ul>

                        <div class="mt-auto d-flex flex-wrap gap-2">
                            <a asp-action="Details"
                                   asp-route-id="@item.EventId"
                                   class="btn btn-outline-primary btn-sm">
                                Details
                            </a>

                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit"
                                       asp-route-id="@item.EventId"
                                       class="btn btn-outline-dark btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                       asp-route-id="@item.EventId"
                                       class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}