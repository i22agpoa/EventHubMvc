@model EventHubMvc.Models.Event

@{
    ViewData["Title"] = "Event Details";
}

<section class="mb-4">
    <h1 class="fw-bold mb-1">Event Details</h1>
    <p class="text-muted mb-0">
        View complete information about this event.
    </p>
</section>

<div class="card shadow-sm border-0">
    <div class="card-body">

        <span class="badge bg-primary mb-3">
            @(Model.Category != null ? Model.Category.Name : "Uncategorized")
        </span>

        <h3 class="fw-bold mb-3">
            @Model.Title
        </h3>

        <p class="text-muted mb-4">
            @Model.Description
        </p>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="border rounded-3 p-3 h-100">
                    <small class="text-muted d-block">Date</small>
                    <strong>@Model.Date.ToString("dd/MM/yyyy HH:mm")</strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="border rounded-3 p-3 h-100">
                    <small class="text-muted d-block">Price</small>
                    <strong>@Model.Price €</strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="border rounded-3 p-3 h-100">
                    <small class="text-muted d-block">Venue</small>
                    <strong>@(Model.Venue != null ? Model.Venue.Address : "Not specified")</strong>
                </div>
            </div>

            <div class="col-md-6">
                <div class="border rounded-3 p-3 h-100">
                    <small class="text-muted d-block">Organizer</small>
                    <strong>@(Model.Organizer != null ? Model.Organizer.Email : "Not specified")</strong>
                </div>
            </div>
        </div>

        <hr />

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit"
                       asp-route-id="@Model?.EventId"
                       class="btn btn-outline-dark">
                    Edit
                </a>
            }
        </div>

    </div>
</div>