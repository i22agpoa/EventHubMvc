@model EventHubMvc.Models.Organizer

@{
    ViewData["Title"] = "Organizer Details";
}

<section class="mb-4">
    <h1 class="fw-bold mb-1">Organizer Details</h1>
    <p class="text-muted mb-0">
        View information about this event organizer.
    </p>
</section>

<div class="card shadow-sm border-0">
    <div class="card-body">

        <span class="badge bg-warning text-dark mb-3">Organizer</span>

        <h3 class="fw-bold mb-3">
            @Model.Name
        </h3>

        <div class="border rounded-3 p-3 mb-4">
            <small class="text-muted d-block">Email</small>
            <strong>@Model.Email</strong>
        </div>

        <p class="text-muted">
            This organizer is registered in EventHub and can manage event information.
        </p>

        <hr />

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                Back to List
            </a>

            @if (User.IsInRole("Admin"))
            {
                <a asp-action="Edit"
                       asp-route-id="@Model?.OrganizerId"
                       class="btn btn-outline-dark">
                    Edit
                </a>
            }
        </div>

    </div>
</div>