@model EventHubMvc.Models.Organizer

@{
    ViewData["Title"] = "Delete Organizer";
}

<section class="mb-4">
    <h1 class="fw-bold mb-1 text-danger">Delete Organizer</h1>
    <p class="text-muted mb-0">Confirm if you want to delete this organizer.</p>
</section>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="alert alert-danger">
            Are you sure you want to delete this organizer?
        </div>

        <span class="badge bg-warning text-dark mb-3">Organizer</span>
        <h3 class="fw-bold">@Model.Name</h3>

        <p class="text-muted">@Model.Email</p>

        <hr />

        <form asp-action="Delete">
            <input type="hidden" asp-for="OrganizerId" />

            <div class="d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-danger">Delete</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>